# All values are safe local examples. Owning service: future API/worker processes.
APP_ENV=local
AWS_REGION=us-east-1
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
DEMO_MODE=fixture
DATA_RETENTION_DAYS=30
# Optional in local fixture mode; required only by their future live adapters.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
BEDROCK_MODEL_ID=
PROMPT_SET_VERSION=
POLICY_VERSION=policy_v1
FEATURE_REGISTRY_PATH=./content/feature-registry/v1.json
