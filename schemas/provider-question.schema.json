{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.local/accesshold/provider-question.schema.json",
  "title": "AccessHold Provider Question Draft",
  "description": "Traveler-reviewable, plan-bound fixture question. It is not sent until the exact hash is approved and the current contract version is rechecked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "trip_id",
    "contract_version",
    "constraint_id",
    "asset_id",
    "provider",
    "provider_reference",
    "recipient",
    "subject",
    "body",
    "template_version",
    "created_at",
    "expires_at",
    "approval_hash",
    "status",
    "provenance"
  ],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "trip_id": { "$ref": "access-contract.schema.json#/$defs/ulid" },
    "contract_version": { "type": "integer", "minimum": 1 },
    "constraint_id": { "$ref": "access-contract.schema.json#/$defs/ulid" },
    "asset_id": { "$ref": "access-contract.schema.json#/$defs/ulid" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
    "provider_reference": { "type": "string", "minLength": 1, "maxLength": 256 },
    "recipient": { "type": "string", "format": "email", "maxLength": 320 },
    "subject": { "type": "string", "minLength": 1, "maxLength": 160 },
    "body": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "template_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "created_at": { "$ref": "access-contract.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "access-contract.schema.json#/$defs/timestamp" },
    "approval_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "const": "draft" },
    "provenance": { "const": "fixture" }
  }
}
