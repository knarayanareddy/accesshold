{
  "meta": {
    "project": "AccessHold",
    "version": "1.0.0",
    "platforms": ["responsive_web", "alexa_rich_card"],
    "theme": "light_evidence_desk",
    "contrast_pairs": {
      "text_on_canvas": { "foreground": "color.text", "background": "color.canvas", "minimum": 4.5 },
      "muted_on_canvas": { "foreground": "color.text_muted", "background": "color.canvas", "minimum": 4.5 },
      "text_on_surface": { "foreground": "color.text", "background": "color.surface", "minimum": 4.5 },
      "muted_on_surface": { "foreground": "color.text_muted", "background": "color.surface", "minimum": 4.5 },
      "primary_button": { "foreground": "color.on_primary", "background": "color.primary", "minimum": 4.5 },
      "accent_button": { "foreground": "color.on_accent", "background": "color.accent", "minimum": 4.5 },
      "focus_on_canvas": { "foreground": "color.focus", "background": "color.canvas", "minimum": 3.0 },
      "success_on_surface": { "foreground": "color.success", "background": "color.surface", "minimum": 4.5 },
      "warning_on_surface": { "foreground": "color.warning", "background": "color.surface", "minimum": 4.5 },
      "danger_on_surface": { "foreground": "color.danger", "background": "color.surface", "minimum": 4.5 }
    }
  },
  "color": {
    "canvas": { "$type": "color", "$value": "#F3F5F7" },
    "surface": { "$type": "color", "$value": "#FFFFFF" },
    "surface_alt": { "$type": "color", "$value": "#E8EEF1" },
    "text": { "$type": "color", "$value": "#142B3A" },
    "text_muted": { "$type": "color", "$value": "#4B5D68" },
    "primary": { "$type": "color", "$value": "#145A73" },
    "on_primary": { "$type": "color", "$value": "#FFFFFF" },
    "accent": { "$type": "color", "$value": "#91421F" },
    "on_accent": { "$type": "color", "$value": "#FFFFFF" },
    "border": { "$type": "color", "$value": "#B9C5CC" },
    "focus": { "$type": "color", "$value": "#7C3F00" },
    "success": { "$type": "color", "$value": "#1E654A" },
    "warning": { "$type": "color", "$value": "#704400" },
    "danger": { "$type": "color", "$value": "#962E3A" },
    "info": { "$type": "color", "$value": "#285A91" }
  },
  "typography": {
    "display": { "$type": "fontFamily", "$value": "Source Sans 3, Segoe UI, sans-serif" },
    "body": { "$type": "fontFamily", "$value": "Source Sans 3, Segoe UI, sans-serif" },
    "data": { "$type": "fontFamily", "$value": "IBM Plex Mono, SFMono-Regular, monospace" },
    "size_display": { "$type": "dimension", "$value": "2.25rem" },
    "size_title": { "$type": "dimension", "$value": "1.5rem" },
    "size_body": { "$type": "dimension", "$value": "1rem" },
    "size_small": { "$type": "dimension", "$value": "0.875rem" },
    "line_body": { "$type": "number", "$value": 1.5 }
  },
  "spacing": {
    "unit": { "$type": "dimension", "$value": "0.25rem" },
    "page": { "$type": "dimension", "$value": "2rem" },
    "section": { "$type": "dimension", "$value": "2.5rem" },
    "control": { "$type": "dimension", "$value": "0.75rem" }
  },
  "shape": {
    "radius_small": { "$type": "dimension", "$value": "6px" },
    "radius_large": { "$type": "dimension", "$value": "12px" },
    "target_minimum": { "$type": "dimension", "$value": "44px" },
    "focus_width": { "$type": "dimension", "$value": "3px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "standard": { "$type": "duration", "$value": "180ms" },
    "easing": { "$type": "cubicBezier", "$value": [0.2, 0.0, 0.0, 1.0] }
  },
  "layout": {
    "content_max": { "$type": "dimension", "$value": "1280px" },
    "reading_max": { "$type": "dimension", "$value": "68ch" },
    "rich_card_max": { "$type": "dimension", "$value": "640px" }
  }
}
